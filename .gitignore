# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*~
.*.swp
.idea/
.vscode/

# Python (skills ship no code, but keep local scratch out)
__pycache__/
*.pyc
.venv/
venv/

# Packaging artifacts — built on release, never committed
*.skill
*.zip
/dist/
/build/

# Local environment
.env
*.log

# Claude Code: track the hooks and neutral settings; local-only permissions
# (settings.local.json) never ship
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# dispatchwright run ledgers — session working state, never a durable artifact
.dispatch/
.claude/hooks/fixtures/window-fit/.control-usage-windows.json
.claude/hooks/fixtures/window-fit/.selftest-usage-windows.json
