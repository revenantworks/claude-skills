{
  "name": "vigil",
  "displayName": "Revenantworks Vigil",
  "description": "The Revenantworks vigil in VS Code: pace, skills fired and flagged, budget mode and the mods kill switch in the status bar, and a read-only panel over the vigil feed. Reads local files only; never writes, runs a process or contacts a service.",
  "version": "1.0.0",
  "publisher": "revenantworks",
  "license": "Apache-2.0",
  "repository": "https://github.com/revenantworks/claude-skills",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "revenantworksDash.openPanel",
        "title": "Revenantworks vigil: open the panel"
      },
      {
        "command": "revenantworksDash.showReadout",
        "title": "Revenantworks vigil: show the readout"
      }
    ]
  }
}
