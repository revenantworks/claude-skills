#!/bin/sh
# pre-push - chains the machine-wide privacy guard (owner 2026-10-15).
# Machine-wide privacy guard (owner 2026-10-15): a repo-local core.hooksPath skips the
# global hooks, so call the guard here. Absent on a machine without it: nothing to do.
g=$(git config --global --get core.hooksPath)
if [ -n "$g" ] && [ -f "$g/pii_guard.py" ]; then
  PY=$(command -v python || command -v python3 || command -v py)
  if [ -n "$PY" ]; then "$PY" "$g/pii_guard.py" pre-push || exit 1; fi
fi
exit 0
